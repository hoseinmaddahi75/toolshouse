{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "outDir": ".medusa/server",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src",
    "medusa-config.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".medusa",
    "src/admin"
  ]
}