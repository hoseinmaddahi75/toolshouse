# Environment Variables Template for Toolshouse Production Deployment
# Copy this file to .env and fill in the values

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=toolshouse

# ===========================================
# Application URLs
# ===========================================
FRONTEND_URL=https://toolshouse.ir
ADMIN_URL=https://admin.toolshouse.ir
BACKEND_URL=https://api.toolshouse.ir

# ===========================================
# Medusa Backend Configuration
# ===========================================
JWT_SECRET=your_secure_jwt_secret_key
COOKIE_SECRET=your_secure_cookie_secret_key

# ===========================================
# Next.js Frontend Configuration
# ===========================================
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.toolshouse.ir
NEXT_PUBLIC_BASE_URL=https://toolshouse.ir

# ===========================================
# GitHub Container Registry
# ===========================================
# These are used by GitHub Actions for image pushing
# GITHUB_TOKEN is automatically provided by GitHub Actions
# SERVER_HOST=your_server_ip_or_domain
# SERVER_USER=your_ssh_username
# SERVER_SSH_KEY=your_private_ssh_key

# ===========================================
# Optional: Email Configuration (if using Medusa email features)
# ===========================================
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ===========================================
# Optional: Storage Configuration (if using external storage)
# ===========================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_S3_ENDPOINT=

# ===========================================
# Note: In production, use proper secrets management
# ===========================================
# - Never commit the actual .env file to version control
# - Use GitHub Secrets for sensitive values in CI/CD
# - On the server, place the .env file in the project root
# - Ensure proper file permissions (600 for .env files)
